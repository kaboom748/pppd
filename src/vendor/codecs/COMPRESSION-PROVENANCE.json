{
  "project": "Linux PPP compression engines and PPP zlib",
  "version": "v6.1",
  "tag_url": "https://github.com/torvalds/linux/tree/v6.1",
  "algorithms": [
    "BSD-Compress 9..15 bits",
    "PPP Deflate 9..15 bits",
    "PPP Deflate draft negotiation"
  ],
  "adaptations": [
    "Kernel includes, allocation/free and module registration replaced by userspace adapter; compression algorithms retained.",
    "BSD unsigned comparison casts remove compiler diagnostics without changing comparison semantics.",
    "BSD bit accumulator is explicitly uint32_t as required by its original algorithm; shifts use unsigned operands to avoid signed-shift undefined behavior on Windows/Linux64.",
    "Kernel inflater alignment pointer cast uses uintptr_t instead of long for Windows LLP64.",
    "Kernel bitrev32 mask sequence adapted into zlib_compat.h; conditional hardware acceleration disabled.",
    "Bounded host API validates input frames, option lengths, MTU/MRU and output buffers."
  ],
